#!/bin/sh
set -eu
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in refs/heads/*) branch=${local_ref#refs/heads/} ;; *) continue ;; esac
  case "$branch" in main) continue ;; esac
  if ! printf '%s\n' "$branch" | grep -Eq '^(feature|fix|hotfix|refactor|docs|test|chore|ci|perf)/[A-Z][A-Z0-9]+-[0-9]+-[a-z0-9]+(-[a-z0-9]+)*$'; then
    echo "Invalid branch: $branch" >&2
    echo 'Example: feature/SMART-123-household-onboarding' >&2
    exit 1
  fi
done
